# Copy this file to ".env" and fill in your own values. Never commit .env.

# Server-side Gemini key (Google AI Studio). Kept on the server only.
GEMINI_API_KEY=
# Optional: Gemini model id. Change it if Google retires the default.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Google Maps JavaScript API *browser* key. This key IS visible to
# every visitor, so restrict it to the Maps JavaScript API and your site URLs.
# Leave empty to use the free Leaflet + OpenStreetMap map.
GOOGLE_MAPS_API_KEY=
# auto = Google if a key is set, otherwise Leaflet. Use "leaflet" to force the free map.
MAP_PROVIDER=auto

# Optional: demo warning thresholds in NM (early warning, caution, high alert, critical).
# NAUTIGUARD_THRESHOLDS_NM=50,25,10,5

# SMS is simulated. A real provider would be configured here in future.
SMS_PROVIDER=none
